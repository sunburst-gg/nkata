# Copy to .env for local runs. Never commit .env.
# If 5432 or 9000 is taken, run make dev with NKATA_PG_PORT or NKATA_S3_PORT set and change the two URLs below.
DATABASE_URL=postgres://nkata:nkata@localhost:5433/nkata
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nkata
S3_ACCESS_KEY=nkata
S3_SECRET_KEY=nkata-dev-secret
NKATA_DEV=1
PORT=7400

# Email. The sign in code and the invites go through Resend (https://resend.com/api-keys).
# Without both, only NKATA_DEV=1 can sign anyone in: the code comes back in the response.
# MAIL_FROM must be an address on a domain verified in Resend.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=Nkata <code@yourdomain.com>

# Signs the model links the app loads. Optional: one server process makes its own key at start.
# Set it when more than one process answers for PUBLIC_URL.
# LINK_SECRET=change-me-to-sixteen-or-more-characters

# Unreal is Coming soon in v1. Set to 1 to turn the mirror, the capture, and the Unreal cards on.
# UNREAL_ENABLED=1

# Deploy (docs/deploy.md). scripts/r2-bucket.sh reads these two; the server never does.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
