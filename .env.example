# Copy to .env for local runs. Never commit .env.
# If 5432 or 9000 is taken, run make dev with NKATA_PG_PORT or NKATA_S3_PORT set and change the two URLs below.
DATABASE_URL=postgres://nkata:nkata@localhost:5433/nkata
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nkata
S3_ACCESS_KEY=nkata
S3_SECRET_KEY=nkata-dev-secret
NKATA_DEV=1
PORT=7400
