{
  "name": "@nkata/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nkata desktop app. Tauri 2, React, Vite. The agent core is a Rust crate in src-tauri.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shots": "node scripts/shots.mjs",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@nkata/shared": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.160.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright-core": "^1.63.0",
    "vite": "^7.3.6",
    "playwright": "^1.63.0"
  }
}
