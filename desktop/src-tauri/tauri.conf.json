{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nkata",
  "version": "0.1.6",
  "identifier": "gg.sunburst.nkata",
  "mainBinaryName": "nkata-desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "features": ["desktop"]
  },
  "app": {
    "windows": [
      {
        "title": "Nkata",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": ["../../blender-addon/", "../../shared/py/", "../../ue5-plugin/"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3QjUzRUFBMkE2QUYxNEIKUldSTDhXb3FxajYxNXlCLzlGNlBGMys0RHY4Ykg0WHNVTGp3WGxpWVlzN1JqZzlNK2owNHkrblEK",
      "endpoints": ["https://nkata-downloads-445567075963.s3.ap-northeast-1.amazonaws.com/latest/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
