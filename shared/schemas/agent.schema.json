{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nkata.dev/schemas/agent.schema.json",
  "title": "Nkata agent local API",
  "description": "http://localhost:7420, loopback only. One request and one response type per route. See docs/engineering.md, Protocols. Editor neutral: part id, object manifest, file, mirror target.",
  "$defs": {
    "ProjectRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Ulid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "folder_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "folder_name"
      ],
      "additionalProperties": false
    },
    "AgentMode": {
      "type": "string",
      "description": "sync: a project folder with index, watcher, and upload. stream: a viewer, files fetched on demand into a capped cache. See docs/engineering.md, Stream mode.",
      "enum": ["sync", "stream"]
    },
    "MeResponse": {
      "description": "GET /me",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "user": {
          "$ref": "common.schema.json#/$defs/UserRef"
        },
        "project": {
          "$ref": "#/$defs/ProjectRef"
        },
        "package_version": {
          "type": "string",
          "minLength": 1
        },
        "online": {
          "type": "boolean"
        },
        "spool_dir": {
          "type": "string",
          "minLength": 1,
          "description": "Folder where Blender writes exports for the mirror: <spool_dir>/<part_id>/<version_id>.glb"
        },
        "mode": {
          "$ref": "#/$defs/AgentMode"
        },
        "mirror_paused": {
          "type": "boolean",
          "description": "True while every mirror waits. Saves still version."
        },
        "unreal": {
          "type": "boolean",
          "description": "False while Unreal is Coming soon (UNREAL_ENABLED on the server): no mirror, no capture, and the panel hides the mirror line."
        }
      },
      "required": [
        "v",
        "user",
        "project",
        "package_version",
        "online",
        "spool_dir",
        "mode",
        "mirror_paused", "unreal"
      ],
      "additionalProperties": false
    },
    "CheckSpec": {
      "type": "object",
      "description": "One check a template runs on a part: the contract id, its severity, and the params.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "severity": {
          "$ref": "common.schema.json#/$defs/CheckSeverity"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "id",
        "severity",
        "params"
      ],
      "additionalProperties": false
    },
    "PartSummary": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Ulid"
        },
        "asset_id": {
          "$ref": "common.schema.json#/$defs/Ulid"
        },
        "asset_name": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "common.schema.json#/$defs/PartState"
        },
        "owner": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/UserRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "lock": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/LockInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "gate": {
          "$ref": "common.schema.json#/$defs/Gate"
        },
        "mapping": {
          "$ref": "common.schema.json#/$defs/PartMapping"
        },
        "kind": {
          "$ref": "template.schema.json#/$defs/TemplateKind",
          "description": "The template kind. Picks the import script and the panel layout."
        },
        "checks": {
          "type": "array",
          "description": "The checks the template runs on this part, in order, with severity and params.",
          "items": {
            "$ref": "#/$defs/CheckSpec"
          }
        },
        "reference_files": {
          "type": "array",
          "description": "The asset's reference files, project relative. The panel's reference strip.",
          "items": {
            "type": "string"
          }
        },
        "waiting_on": {
          "type": "array",
          "description": "Gate parts not yet Approved. Empty when the part is open.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "asset_id",
        "asset_name",
        "name",
        "state",
        "owner",
        "lock",
        "gate",
        "mapping",
        "kind",
        "checks",
        "reference_files",
        "waiting_on"
      ],
      "additionalProperties": false
    },
    "PartsResponse": {
      "description": "GET /parts?file=",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartSummary"
          }
        }
      },
      "required": [
        "v",
        "parts"
      ],
      "additionalProperties": false
    },
    "PartOpenResponse": {
      "description": "POST /parts/:id/open. Granted, or the holder so the panel can show a request-unlock button.",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "granted": {
          "type": "boolean"
        },
        "lock": {
          "$ref": "common.schema.json#/$defs/LockInfo"
        }
      },
      "required": [
        "v",
        "granted",
        "lock"
      ],
      "additionalProperties": false
    },
    "PartCloseResponse": {
      "description": "POST /parts/:id/close",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "released": {
          "type": "boolean"
        }
      },
      "required": [
        "v",
        "released"
      ],
      "additionalProperties": false
    },
    "ManifestObject": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "triangles": {
          "type": "integer",
          "minimum": 0
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bounds_min": {
          "$ref": "common.schema.json#/$defs/Vec3"
        },
        "bounds_max": {
          "$ref": "common.schema.json#/$defs/Vec3"
        },
        "hash": {
          "type": "string",
          "description": "Hash of mesh data, material slots, and transform."
        },
        "origin": {
          "$ref": "common.schema.json#/$defs/Vec3",
          "description": "World position of the object origin. A prop's origin sits at the base of its bounds."
        },
        "scale": {
          "$ref": "common.schema.json#/$defs/Vec3",
          "description": "Object scale. A prop exports at 1, 1, 1."
        }
      },
      "required": [
        "name",
        "triangles",
        "materials",
        "bounds_min",
        "bounds_max",
        "hash",
        "origin",
        "scale"
      ],
      "additionalProperties": false
    },
    "ObjectManifest": {
      "type": "object",
      "description": "Written next to the export in the spool. See docs/engineering.md, The mirror, step 2.",
      "properties": {
        "v": {
          "const": 1
        },
        "kind": {
          "$ref": "template.schema.json#/$defs/TemplateKind"
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ManifestObject"
          }
        },
        "bone_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "Bones in the armature for a character part, null otherwise."
        },
        "armature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "mirror_target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Destination path in the engine, from the part mapping."
        }
      },
      "required": [
        "v",
        "kind",
        "objects",
        "bone_count",
        "armature",
        "mirror_target"
      ],
      "additionalProperties": false
    },
    "PartSavedRequest": {
      "description": "POST /parts/:id/saved, from Blender on save_post.",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "changed": {
          "type": "boolean"
        },
        "spool_path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectManifest"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "opened_at": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/Timestamp" }, { "type": "null" }],
          "description": "When the editor opened the file, for the version's opened_at."
        }
      },
      "required": [
        "v",
        "changed",
        "spool_path",
        "manifest",
        "source_file"
      ],
      "additionalProperties": false
    },
    "PartSavedResponse": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "version_id": {
          "$ref": "common.schema.json#/$defs/Ulid"
        },
        "mirror": {
          "$ref": "common.schema.json#/$defs/MirrorStatus"
        }
      },
      "required": [
        "v",
        "version_id",
        "mirror"
      ],
      "additionalProperties": false
    },
    "PublishRequest": {
      "description": "POST /parts/:id/publish",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "check_results": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/CheckResult"
          }
        },
        "ready": {
          "type": "boolean"
        }
      },
      "required": [
        "v",
        "check_results",
        "ready"
      ],
      "additionalProperties": false
    },
    "PublishResponse": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "published": {
          "type": "boolean"
        },
        "version_id": {
          "$ref": "common.schema.json#/$defs/Ulid"
        },
        "state": {
          "$ref": "common.schema.json#/$defs/PartState"
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/CheckResult"
          }
        },
        "render_needed": {
          "type": "boolean",
          "description": "True after Mark Ready when UE5 gave no viewport capture: Blender renders and posts it to /parts/:id/render."
        }
      },
      "required": [
        "v",
        "published",
        "version_id",
        "state",
        "blocked_by",
        "render_needed"
      ],
      "additionalProperties": false
    },
    "ChecksRequest": {
      "description": "POST /parts/:id/checks",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/CheckResult"
          }
        }
      },
      "required": [
        "v",
        "results"
      ],
      "additionalProperties": false
    },
    "ChecksResponse": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "version_id": {
          "$ref": "common.schema.json#/$defs/Ulid"
        },
        "recorded": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "v",
        "version_id",
        "recorded"
      ],
      "additionalProperties": false
    },
    "CommentsResponse": {
      "description": "GET /parts/:id/comments",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/CommentPin"
          }
        }
      },
      "required": [
        "v",
        "comments"
      ],
      "additionalProperties": false
    },
    "CommentCreateRequest": {
      "description": "POST /parts/:id/comments",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "point": {
          "$ref": "common.schema.json#/$defs/Vec3"
        },
        "normal": {
          "$ref": "common.schema.json#/$defs/Vec3"
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "common.schema.json#/$defs/CommentKind",
          "description": "Defaults to pin."
        }
      },
      "required": [
        "v",
        "point",
        "normal",
        "body"
      ],
      "additionalProperties": false
    },
    "CommentCreateResponse": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "comment": {
          "$ref": "common.schema.json#/$defs/CommentPin"
        }
      },
      "required": [
        "v",
        "comment"
      ],
      "additionalProperties": false
    },
    "ReviewRequest": {
      "description": "POST /parts/:id/review, UE5 only, art director only.",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "decision": {
          "$ref": "common.schema.json#/$defs/ReviewDecision"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "v",
        "score",
        "decision",
        "note"
      ],
      "additionalProperties": false
    },
    "ReviewResponse": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "review_id": {
          "$ref": "common.schema.json#/$defs/Ulid"
        },
        "state": {
          "$ref": "common.schema.json#/$defs/PartState"
        }
      },
      "required": [
        "v",
        "review_id",
        "state"
      ],
      "additionalProperties": false
    },
    "PresenceRequest": {
      "description": "POST /presence, every 15 s.",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "part_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Ulid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "v",
        "part_id"
      ],
      "additionalProperties": false
    },
    "PresenceResponse": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "online": {
          "type": "array",
          "items": {
            "$ref": "events.schema.json#/$defs/PresenceEntry"
          }
        }
      },
      "required": [
        "v",
        "online"
      ],
      "additionalProperties": false
    },
    "AgentEvent": {
      "description": "GET /events (SSE). The agent relays these server events to editors.",
      "oneOf": [
        {
          "$ref": "events.schema.json#/$defs/PresenceChanged"
        },
        {
          "$ref": "events.schema.json#/$defs/LockGranted"
        },
        {
          "$ref": "events.schema.json#/$defs/LockReleased"
        },
        {
          "$ref": "events.schema.json#/$defs/LockRequested"
        },
        {
          "$ref": "events.schema.json#/$defs/MirrorResult"
        },
        {
          "$ref": "events.schema.json#/$defs/PartStateChanged"
        },
        {
          "$ref": "events.schema.json#/$defs/CommentCreated"
        }
      ]
    },
    "MirrorRetryResponse": {
      "description": "POST /parts/:id/mirror/retry. Clears the failure count and queues the newest pending mirror again.",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "part_id": {
          "$ref": "common.schema.json#/$defs/Ulid"
        },
        "queued": {
          "type": "boolean"
        }
      },
      "required": [
        "v",
        "part_id",
        "queued"
      ],
      "additionalProperties": false
    },
    "MirrorState": {
      "description": "What the agent knows about one part's mirror, for the panels.",
      "type": "object",
      "properties": {
        "part_id": {
          "$ref": "common.schema.json#/$defs/Ulid"
        },
        "status": {
          "$ref": "common.schema.json#/$defs/MirrorStatus"
        },
        "version_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Ulid"
            },
            {
              "type": "null"
            }
          ]
        },
        "at": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "mirror_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        },
        "failures": {
          "type": "integer",
          "minimum": 0
        },
        "halted": {
          "type": "boolean",
          "description": "True after three failures in a row. Retry clears it."
        },
        "on_save": {
          "type": "boolean",
          "description": "False: this part's saves version but do not mirror until turned on again."
        }
      },
      "required": [
        "part_id",
        "status",
        "version_id",
        "at",
        "mirror_ms",
        "message",
        "failures",
        "halted",
        "on_save"
      ],
      "additionalProperties": false
    },
    "MirrorStateResponse": {
      "description": "GET /parts/:id/mirror",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "mirror": {
          "$ref": "#/$defs/MirrorState"
        }
      },
      "required": [
        "v",
        "mirror"
      ],
      "additionalProperties": false
    },
    "MirrorOnSaveRequest": {
      "description": "POST /parts/:id/mirror/on-save",
      "type": "object",
      "properties": {
        "v": { "const": 1 },
        "on_save": { "type": "boolean" }
      },
      "required": ["v", "on_save"],
      "additionalProperties": false
    },
    "MirrorPauseRequest": {
      "description": "POST /mirror/pause. Pauses every mirror; saves still version.",
      "type": "object",
      "properties": {
        "v": { "const": 1 },
        "paused": { "type": "boolean" }
      },
      "required": ["v", "paused"],
      "additionalProperties": false
    },
    "MirrorPauseResponse": {
      "type": "object",
      "properties": {
        "v": { "const": 1 },
        "paused": { "type": "boolean" }
      },
      "required": ["v", "paused"],
      "additionalProperties": false
    },
    "RenderRequest": {
      "description": "POST /parts/:id/render. A PNG on disk the agent stores as the current version's render.",
      "type": "object",
      "properties": {
        "v": { "const": 1 },
        "path": { "type": "string", "minLength": 1 }
      },
      "required": ["v", "path"],
      "additionalProperties": false
    },
    "RenderResponse": {
      "type": "object",
      "properties": {
        "v": { "const": 1 },
        "version_id": { "$ref": "common.schema.json#/$defs/Ulid" },
        "stored": { "type": "boolean" }
      },
      "required": ["v", "version_id", "stored"],
      "additionalProperties": false
    }
  }
}
